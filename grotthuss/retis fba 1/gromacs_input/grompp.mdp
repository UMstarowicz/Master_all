integrator               = md
dt                       = 0.001
nsteps                   = 5000

nstxout                  = 5000
nstvout                  = 5000
nstenergy                = 500
nstlog                   = 500
nstxout-compressed       = 0

continuation             = yes
constraint-algorithm     = lincs
constraints              = none

cutoff-scheme            = Verlet
coulombtype              = PME
rcoulomb                 = 1.2
vdwtype                  = Cut-off
rvdw                     = 1.2
DispCorr                 = EnerPres

tcoupl                   = Nose-Hoover
tc-grps                  = System
tau-t                    = 0.5
ref-t                    = 300.0
nhchainlength            = 1

pcoupl                   = C-rescale
pcoupltype               = isotropic
tau_p                    = 5.0
compressibility          = 4.5e-5
ref_p                    = 1.0

gen_vel                  = no
