heading = {'text': '; PyRETIS input for water autoionization / Grotthuss initiation detection\n; Based on: Moqadam et al., PNAS 2018\n;\n; ORDER PARAMETER: λ = largest O-H bond distance in system (nm)\n; Paper uses AIMD with BLYP/DZVP, 32 waters, 300 K, NVE\n; We use SPC/Fw, 1000 waters, 300 K, NPT\n;\n; INTERFACES:\n;   Paper (AIMD, Angstrom): 1.07, 1.10, 1.13, 1.16, 1.19, 1.22 ...\n;   Here (nm, SPC/Fw):      0.107, 0.109, 0.111, 0.113, 0.115, 0.117, 0.120\n;\n;   SPC/Fw O-H equilibrium = 0.1012 nm, fluctuates ±0.005 nm typically\n;   Interfaces cover the tail of the distribution up to stretched bonds\n;   The "reactive initiation" threshold from paper = 1.15 Å = 0.115 nm\n;\n; KEY RESULT FROM PAPER (Fig. 3, 4, 5):\n;   When λ crosses 1.15-1.16 Å (0.115-0.116 nm), the trajectory outcome\n;   is predicted by: w4, q (tetrahedral OP), na (H-bonds accepted), qcos\n;   The ML classifier (grotthuss_ml_classifier.py) computes these CVs\n;   from the accepted PyRETIS paths.\n;\n; IMPORTANT NOTE:\n;   With classical SPC/Fw, bonds cannot break → true autoionization\n;   cannot occur. The simulation captures initiation conditions only.\n;   For full reactive dynamics, replace GROMACS with CP2K+BLYP or\n;   ASE+MACE-MP-0 (see documentation).\nRetis Water Autoionization - Moqadam 2018\n=========================================='}
simulation task = retis
simulation steps = 500
simulation interfaces = [0.1085, 0.1105, 0.1115]
simulation zero_left = 0.1078
simulation exe_path = /home/ula/pyretis_run/project_masters/retis_grotthuss
simulation rgen = rgen
simulation priority_shooting = False
simulation flux = True
simulation zero_ensemble = True
system units = gromacs
system dimensions = 3
system temperature = 1.0
engine class = gromacs2
engine gmx = gmx
engine mdrun = gmx mdrun -ntmpi 1 -ntomp 8
engine input_path = gromacs_input
engine timestep = 0.001
engine subcycles = 5000
engine gmx_format = gro
engine maxwarn = 1
engine exe_path = /home/ula/pyretis_run/project_masters/retis_grotthuss
engine rgen = rgen
engine type = external
engine input_files conf = /home/ula/pyretis_run/project_masters/retis_grotthuss/gromacs_input/conf.gro
engine input_files input_o = /home/ula/pyretis_run/project_masters/retis_grotthuss/gromacs_input/grompp.mdp
engine input_files topology = /home/ula/pyretis_run/project_masters/retis_grotthuss/gromacs_input/topol.top
engine input_files index = /home/ula/pyretis_run/project_masters/retis_grotthuss/gromacs_input/index.ndx
tis freq = 0.5
tis maxlength = 50000
tis aimless = True
tis allowmaxlength = False
tis zero_momentum = False
tis rescale_energy = False
tis sigma_v = -1
tis seed = 0
tis shooting_move = sh
tis high_accept = False
tis rgen = rgen
tis shooting_moves = []
tis mirror_freq = 0
tis target_freq = 0
tis target_indices = []
tis ensemble_number = 5
tis detect = 0.111
retis swapfreq = 0.5
retis relative_shoots = None
retis nullmoves = True
retis swapsimul = True
initial-path method = load
initial-path load_folder = load
orderparameter class = WaterAutoionization
orderparameter module = orderp_grotthuss.py
orderparameter name = Order Parameter
output pathensemble-file = 1
output order-file = 1
output energy-file = 1
output trajectory-file = 50
output backup = append
output cross-file = 1
output restart-file = 1
output screen = 10
particles type = external
analysis blockskip = 1
analysis bins = 100
analysis maxblock = 1000
analysis maxordermsd = -1
analysis ngrid = 1001
analysis plot plotter = mpl
analysis plot output = png
analysis plot style = pyretis
analysis report = ['latex', 'rst', 'html']
analysis skipcross = 1000
analysis txt-output = txt.gz
analysis tau_ref_bin = []
analysis skip = 0
interface = 0.1105

