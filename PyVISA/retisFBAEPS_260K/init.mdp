integrator               = md
dt                       = 0.001
nsteps                   = 500000
nstxout                  = 500
nstvout                  = 500
nstenergy                = 500
nstlog                   = 2000
continuation             = no
gen_vel                  = yes
gen-temp                 = 270.0
gen-seed                 = -1
constraint-algorithm     = lincs
constraints              = none
cutoff-scheme            = Verlet
coulombtype              = PME
rcoulomb                 = 1.2
vdwtype                  = Cut-off
rvdw                     = 1.2
DispCorr                 = EnerPres
tcoupl                   = Nose-Hoover
tc-grps                  = System
tau-t                    = 0.5
ref-t                    = 270.0
nhchainlength            = 1
pcoupl                   = Parrinello-Rahman
pcoupltype               = isotropic
tau_p                    = 2.0
compressibility          = 4.5e-5
ref_p                    = 1000.0
