integrator      = md
dt              = 0.001
nsteps          = 100000
nstxout         = 1000
nstvout         = 1000
nstenergy       = 100
nstlog          = 100
constraints     = none
continuation    = no
gen_vel         = yes
gen-temp        = 300.0
tcoupl          = Nose-Hoover
tc-grps         = System
tau-t           = 0.5
ref-t           = 300.0
nhchainlength   = 1
pcoupl          = no
cutoff-scheme   = Verlet
coulombtype     = PME
rcoulomb        = 1.2
vdwtype         = Cut-off
rvdw            = 1.2
DispCorr        = EnerPres
