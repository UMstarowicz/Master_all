; FBA/epsilon flexible water model
; Fuentes-Azcatl & Barbosa, J. Mol. Liquids (2020)
; DOI: 10.1016/j.molliq.2020.112598
;
; Parameters from Table 1:
;   r0     = 1.027 Ang = 0.10270 nm
;   k_b    = 3000 kJ/mol/Ang^2 -> GROMACS: 2 x 3000 x 100 = 600000 kJ/mol/nm^2
;   theta0 = 114.70 deg
;   k_a    = 383 kJ/mol/rad^2  -> GROMACS: 2 x 383 = 766 kJ/mol/rad^2
;   sigma  = 3.1776 Ang = 0.31776 nm
;   eps    = 0.792324 kJ/mol
;   qO     = -0.8450 e
;   qH     = +0.4225 e

[ moleculetype ]
; name  nrexcl
SOL     2

[ atoms ]
;  nr  type      resnr  residu  atom  cgnr  charge     mass
    1  OW_spcfw  1      SOL     OW    1    -0.84500   15.99940
    2  HW_spcfw  1      SOL     HW1   1     0.42250    1.00800
    3  HW_spcfw  1      SOL     HW2   1     0.42250    1.00800

[ bonds ]
;  ai  aj  funct  r0(nm)    kb(kJ/mol/nm^2)
    1   2   1     0.10270   600000.0
    1   3   1     0.10270   600000.0

[ angles ]
;  ai  aj  ak  funct  theta0(deg)  ktheta(kJ/mol/rad^2)
    2   1   3   1     114.700      766.0

[ exclusions ]
    1   2
    1   3
    2   3
