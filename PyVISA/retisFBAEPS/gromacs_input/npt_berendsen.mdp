integrator      = md
dt              = 0.001
nsteps          = 200000
nstxout         = 1000
nstvout         = 1000
nstenergy       = 100
nstlog          = 100
constraints     = none
continuation    = yes
gen_vel         = no
tcoupl          = Nose-Hoover
tc-grps         = System
tau-t           = 0.5
ref-t           = 300.0
nhchainlength   = 1
pcoupl          = Berendsen
pcoupltype      = isotropic
tau_p           = 0.5
compressibility = 4.5e-5
ref_p           = 1.0
cutoff-scheme   = Verlet
coulombtype     = PME
rcoulomb        = 1.2
vdwtype         = Cut-off
rvdw            = 1.2
DispCorr        = EnerPres
