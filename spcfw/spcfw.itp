; SPC/Fw flexible water model
; Reference: Wu, Tepper & Voth, J. Chem. Phys. 124, 024503 (2006)
;
; Parameters (all converted to GROMACS units):
;   O-H bond:   r0=0.1012 nm, K_r=1059.162 kcal/mol/A^2 (paper uses V=k(r-r0)^2, no 1/2)
;               => GROMACS kb = 2 x 1059.162 x 4.184 x 100 = 886062 kJ/mol/nm^2
;   H-O-H angle: theta0=113.24 deg, K_theta=75.90 kcal/mol/rad^2
;               => GROMACS ktheta = 2 x 75.90 x 4.184 = 635.1 kJ/mol/rad^2
;   LJ on O:    sigma=0.31655 nm, epsilon=0.6503 kJ/mol
;   Charges:    qO=-0.82e, qH=+0.41e
;
; NOTE: This is a FLEXIBLE model. Do NOT use constraints=h-bonds in the .mdp.
;       Use constraints=none and a timestep of 0.001 ps (or 0.0005 ps for safety).

[ moleculetype ]
; name  nrexcl
SOL     2

[ atoms ]
;  nr  type  resnr  residu  atom  cgnr  charge    mass
    1  OW_spcfw  1  SOL  OW    1  -0.82000  15.99940
    2  HW_spcfw  1  SOL  HW1   1   0.41000   1.00800
    3  HW_spcfw  1  SOL  HW2   1   0.41000   1.00800

[ bonds ]
;  ai  aj  funct  r0 (nm)  kb (kJ/mol/nm^2)
    1   2   1     0.10120  886062.0
    1   3   1     0.10120  886062.0

[ angles ]
;  ai  aj  ak  funct  theta0 (deg)  ktheta (kJ/mol/rad^2)
    2   1   3   1     113.240       635.1

[ exclusions ]
    1   2
    1   3
    2   3
